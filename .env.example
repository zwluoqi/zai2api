# ===================
# 服务器配置
# ===================
PORT=8000

# ===================
# API 配置
# ===================
# API 端点地址（兼容旧配置；推荐在 config.json 的 api.endpoints 中配置，管理页也会写入 config.json）
API_ENDPOINT=https://chat.z.ai/api/v2/chat/completions

# 认证令牌（支持多个，逗号分隔）
# 用于验证客户端请求
AUTH_TOKEN=sk-your-token-here

# 备用令牌（支持多个，逗号分隔）
# 用于多模态请求
BACKUP_TOKEN=

# ===================
# 功能配置
# ===================
# 调试日志
DEBUG_LOGGING=false

# 工具调用支持
TOOL_SUPPORT=true

# 注：Token 重试次数(retry_count)与模型降级链(model_fallbacks)已改为在
# 管理面板「系统设置」中配置并持久化到 config.json，不再通过环境变量设置。

# 跳过认证令牌验证
SKIP_AUTH_TOKEN=false

# 扫描限制（字符数）
SCAN_LIMIT=200000

# 日志级别: debug, info, warn, error
LOG_LEVEL=info

# 是否向上游发送随机 X-Forwarded-For/X-Real-IP。默认关闭以更接近真实浏览器 fetch。
SPOOF_CLIENT_IP=false

# 管理面板令牌；为空时不启用管理面板鉴权
ADMIN_TOKEN=

# ===================
# 人机验证 (Captcha)
# ===================
# z.ai 已对 chat completions 强制阿里云无痕验证。开启后用内嵌无头浏览器自动生成 captcha_verify_param。
# 需运行环境能安装 Chromium（VPS/Docker）；Cloudflare Worker 不支持。
CAPTCHA_AUTO_GEN=false
# 无头运行（无显示环境保持 true；配合 xvfb 可设 false 提高通过率）
CAPTCHA_HEADLESS=true
# Chromium/Chrome 路径，留空自动探测
CAPTCHA_BROWSER_BIN=
# 生成 captcha 的浏览器走此代理（强烈建议住宅 IP）。机房/VPS IP 会被阿里云判高风险，
# 导致上游返回 FRONTEND_CAPTCHA_REQUIRED / 人机验证失败。支持 http://user:pass@host:port
CAPTCHA_BROWSER_PROXY=
# 预热池大小（token 一次性）
CAPTCHA_POOL_SIZE=4
# 单个 token 生成超时（秒）
CAPTCHA_GEN_TIMEOUT_SECONDS=20
# 手动兜底 captcha token（非空时优先，仅用于临时抓包验证）
CAPTCHA_VERIFY_PARAM=

# 注册器浏览器：adspower 或 local
ZAI_BROWSER=adspower
ADSPOWER_API_URL=http://127.0.0.1:50325
ADSPOWER_GROUP_ID=0
ZAI_VISION_BASE_URL=https://oneapi.gemiaude.com
ZAI_VISION_MODEL=gemini-3-flash-preview

# ===================
# 显示配置
# ===================
# 多行备注，在 / 端点显示
# 支持 | 或 \n 作为换行符
# 示例: NOTE=第一行|第二行|第三行
NOTE=
